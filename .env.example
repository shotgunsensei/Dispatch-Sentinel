# Dispatch Sentinel Phase 14 production MVP vertical slice
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4310
LOG_LEVEL=info
DATABASE_URL=postgres://user:password@localhost:5432/dispatch_sentinel
BMS_WEBHOOK_SECRET=change-me-for-local-phase1
APPROVAL_TOKEN_SECRET=change-me-for-local-approvals
DATTO_RMM_EXECUTION_ENABLED=false
DATTO_RMM_TIMEOUT_MS=10000
AUTOMATION_CALLBACK_BASE_URL=http://127.0.0.1:4310
COMPONENT_CALLBACK_SECRET=change-me-for-local-components
AUTOMATION_CALLBACK_SECRET=change-me-for-local-phase7
AUTOMATION_JOB_TIMEOUT_MINUTES=30
BMS_WRITES_ENABLED=false
BMS_QUEUE_AUTOMATION_REVIEW=Automation Review
BMS_QUEUE_LEVEL1=Level 1
BMS_QUEUE_LEVEL2=Level 2
BMS_QUEUE_SECURITY=Security
BMS_QUEUE_HUMAN_REVIEW=Human Review
BMS_STATUS_AUTO_TRIAGE=Auto-Triage
BMS_STATUS_AWAITING_CLIENT_CONFIRMATION=Awaiting Client Confirmation
BMS_STATUS_AUTOMATION_RUNNING=Automation Running
BMS_STATUS_NEEDS_QA=Needs QA
BMS_STATUS_ESCALATED=Escalated
BMS_STATUS_COMPLETED=Completed
BMS_QUEUE_AUTO_ELIGIBLE=false
BMS_DENY_AUTOMATION_ROUTE_TO_HUMAN=true
BMS_SUCCESS_PUBLIC_NOTE_ENABLED=false
BMS_CLOSE_TICKETS_ENABLED=false
BMS_PRIORITY_UPDATES_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@dispatch.local
ADMIN_BOOTSTRAP_PASSWORD=change-me-for-local-admin
ADMIN_SETUP_TOKEN=change-me-for-admin-setup
ADMIN_SESSION_SECRET=change-me-for-signed-admin-sessions
DISPATCH_SENTINEL_ENCRYPTION_KEY=base64-encoded-32-byte-key
DISPATCH_SENTINEL_ENCRYPTION_KEY_VERSION=v1
ADMIN_ALLOWED_ORIGIN=http://localhost:3000
ADMIN_SESSION_TTL_MINUTES=480
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
APPROVAL_RATE_LIMIT_PER_MINUTE=30
ADMIN_RATE_LIMIT_PER_MINUTE=120
GLOBAL_AUTOMATION_DISABLED=false
DRY_RUN_ONLY=false

# Web project
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4310

